[copr:copr.fedorainfracloud.org:opuk:bottom]
name=Copr repo for bottom owned by opuk
baseurl=https://download.copr.fedorainfracloud.org/results/opuk/bottom/fedora-$releasever-$basearch/
type=rpm-md
skip_if_unavailable=True
gpgcheck=1
gpgkey=https://download.copr.fedorainfracloud.org/results/opuk/bottom/pubkey.gpg
repo_gpgcheck=0
enabled=1
enabled_metadata=1
