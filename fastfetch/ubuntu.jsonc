            "key": "│ ├󰏖",
            "keyColor": "#AEA79F"
        },
        {
            "type": "shell",
            "key": "│ └",
            "keyColor": "#AEA79F"
        },
        {
            "type": "wm",
            "key": " DE/WM",
            "keyColor": "#DEDBD8"
        },
        {
            "type": "wmtheme",
            "key": "│ ├󰉼",
            "keyColor": "#DEDBD8"
        },
        {
            "type": "icons",
            "key": "│ ├󰀻",
            "keyColor": "#DEDBD8"
        },
        {
