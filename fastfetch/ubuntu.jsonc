            "key": "│ ├",
            "keyColor": "#DEDBD8"
        },
        {
            "type": "terminalfont",
            "key": "│ ├",
            "keyColor": "#DEDBD8"
        },
        {
            "type": "terminal",
            "key": "│ └",
            "keyColor": "#DEDBD8"
        },
        {
